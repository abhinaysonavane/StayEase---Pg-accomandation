# ==============================================================================
# StayEase PG Accommodation & Coliving Platform — Unified Environment Example
# ==============================================================================

# --- BACKEND (FastAPI / Uvicorn Service) ---
PROJECT_NAME="StayEase PG Accommodation Platform"
API_V1_STR="/api"
APP_ENV="development"
SERVER_HOST="127.0.0.1"
SERVER_PORT=8000

# Database Configuration (MySQL 8.x / 9.x or auto-fallback to SQLite when offline)
DATABASE_URL="mysql+pymysql://root:@localhost:3306/stayease_db?charset=utf8mb4"

# JWT & Cookie Session Security
SECRET_KEY="stayease-dev-secret-key-replace-in-production-min32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Development Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000"

# Genuine Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP Email Configuration (Optional for Password Reset)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@stayease.com"

# --- FRONTEND (React + Vite Client) ---
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
VITE_GOOGLE_CLIENT_ID=""
