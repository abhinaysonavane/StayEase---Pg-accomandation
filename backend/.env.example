# StayEase Environment Variables Template
PROJECT_NAME="StayEase PG Accommodation Platform"
API_V1_STR="/api"
APP_ENV="development"

# Server Configuration
SERVER_HOST="127.0.0.1"
SERVER_PORT=8000

# MySQL Database Configuration
DATABASE_URL="mysql+pymysql://root:@localhost:3306/stayease_db?charset=utf8mb4"

# Secret Key for JWT Token Generation
SECRET_KEY="stayease-super-secret-jwt-key-replace-in-production-min32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Application URL
FRONTEND_URL="http://localhost:5173"

# Google OAuth 2.0 / OpenID Connect Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Delivery Configuration (SMTP)
# If empty or in development, email fallback logs reset links to server console
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@stayease.com"
SMTP_FROM_NAME="StayEase Accommodations"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000"

